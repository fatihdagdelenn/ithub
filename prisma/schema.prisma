generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  role         String   @default("USER")
  createdAt    DateTime @default(now())

  favorites UserFavorite[]
  groups    UserGroup[]

  @@map("users")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String   @default("folder")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  systems System[]
  groups  GroupCategory[]

  @@map("categories")
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  systems SystemTag[]

  @@map("tags")
}

model System {
  id            String    @id @default(cuid())
  name          String
  type          String
  host          String?
  url           String
  description   String?
  isOnline      Boolean?
  lastCheckedAt DateTime?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  tags        SystemTag[]
  favoritedBy UserFavorite[]

  @@map("systems")
}

model SystemTag {
  systemId String
  tagId    String

  system System @relation(fields: [systemId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([systemId, tagId])
  @@map("system_tags")
}

// Per-user favorites: each user stars systems for themselves only.
model UserFavorite {
  userId    String
  systemId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  system System @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@id([userId, systemId])
  @@map("user_favorites")
}

// Access groups. A (non-admin) user sees the union of the categories of every group they belong
// to; admins always see everything. There are no "deny" rules: not being in a group that grants a
// category is how a category is hidden.
model Group {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  // When true the group grants every category, including ones created later.
  allCategories Boolean  @default(false)
  createdAt     DateTime @default(now())

  members    UserGroup[]
  categories GroupCategory[]

  @@map("groups")
}

model UserGroup {
  userId  String
  groupId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@map("user_groups")
}

model GroupCategory {
  groupId    String
  categoryId String

  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([groupId, categoryId])
  @@map("group_categories")
}
