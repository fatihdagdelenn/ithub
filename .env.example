DATABASE_URL="file:../data/ithub.db"
SESSION_SECRET="replace-with-a-random-32-plus-character-secret"

# Used only by prisma/seed.ts to create the initial admin account
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Administrator"

# Set to "true" only if this app is served over HTTPS (e.g. behind a reverse proxy with TLS).
# Leave "false" for plain HTTP access, otherwise the login cookie will be rejected by browsers.
COOKIE_SECURE="false"

# How often (in minutes) the background job checks each system's URL for reachability (HTTP HEAD,
# not ICMP ping) and updates the online/offline dot shown on its card. Keep this generous - it's a
# convenience indicator, not a monitoring system.
HEALTH_CHECK_INTERVAL_MINUTES="10"
